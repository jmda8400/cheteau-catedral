{
    "name": "chateau-catedral/website",
    "type": "project",
    "description": "Sitio web de Chateau Catedral.",
    "require": {"php": "^8.2", "laravel/framework": "^12.0", "laravel/tinker": "^2.10"},
    "require-dev": {"laravel/sail": "^1.41", "phpunit/phpunit": "^11.5"},
    "autoload": {"psr-4": {"App\\": "app/"}},
    "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]},
    "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
